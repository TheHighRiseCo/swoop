{
  "manifest_version": 3,
  "name": "SWOOP \u2014 Instagram Post Saver",
  "version": "1.3.0",
  "description": "Save Instagram posts in bulk; schedule through Zernio or Postiz, or prepare local posting reminders.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SWOOP \u2014 Save this Instagram post",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "post-target.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-128.png"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://zernio.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.r2.cloudflarestorage.com/*",
    "https://media.zernio.com/*",
    "https://api.postiz.com/*",
    "http://127.0.0.1/*"
  ],
  "optional_permissions": [
    "notifications"
  ]
}
